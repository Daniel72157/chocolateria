{
  "name": "chocolateria",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api \"vite\" \"tsx watch --env-file-if-exists=.env server/dev.ts\"",
    "build": "tsc --noEmit && vite build",
